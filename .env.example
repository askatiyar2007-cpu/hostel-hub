# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Knit Pay (RapidAPI UPI gateway)
NEXT_PUBLIC_KNITPAY_KEY_ID=
KNITPAY_API_KEY=
KNITPAY_API_SECRET=
KNITPAY_MERCHANT_ID=
KNITPAY_MODE=sandbox
RAPIDAPI_HOST=knit-pay-upi.p.rapidapi.com

# SMS OTP providers (optional; OTP is logged to the console when unset)
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
